---
import { site } from '../data/site';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/stays', label: 'Stays' },
  { href: '/#why', label: 'Why stay' },
  { href: '/#long-stays', label: 'Long stays' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="site-header" data-header data-home={home ? 'true' : undefined}>
  <div class="bar">
    <a href="/" class="wordmark" aria-label="Marvelous Living, home">
      <span>Marvelous</span> <em>Living</em>
    </a>
    <nav aria-label="Main">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={path.startsWith(l.href) && l.href !== '/' ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--small" href={site.whatsappEnquiry} target="_blank" rel="noopener">
      Check dates<span class="visually-hidden"> on WhatsApp (opens in a new tab)</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding: 0.85rem var(--gutter);
    pointer-events: none;
  }
  .bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: calc(var(--container) + 2rem);
    margin-inline: auto;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgba(42, 27, 18, 0.08);
    box-shadow: 0 8px 28px -18px rgba(42, 27, 18, 0.45);
  }
  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'opsz' 48;
    font-size: 1.3rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .wordmark em { color: var(--rust); }
  /* On home the big hero wordmark plays the logo until it scrolls away. */
  :global(html.js) [data-home] .wordmark { opacity: 0; transform: translateY(8px); }
  :global(html.js) [data-home].is-scrolled .wordmark { opacity: 1; transform: none; }

  nav { margin-left: auto; }
  nav ul { display: flex; gap: 0.25rem; }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: background-color 0.25s;
  }
  nav a:hover, nav a[aria-current='page'] { background: var(--bg-alt); }
  .btn--small { min-height: 44px; padding: 0.55rem 1.2rem; }

  @media (max-width: 760px) {
    nav ul li:not(:first-child) { display: none; }
    .bar { gap: 0.5rem; padding-left: 1rem; }
    .wordmark { font-size: 1.1rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.55);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
