---
import { site } from '../data/site';
import { properties } from '../data/properties';
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="cols">
      <div>
        <img class="logo" src="/images/ml-logo-light.svg" alt="Marvelous Living" width="533" height="157" loading="lazy" />
        <p class="intro">Serviced apartments in Bengaluru for short and medium stays. Book on Airbnb, or message us on WhatsApp for the fastest reply.</p>
      </div>
      <nav aria-label="Stays">
        <h2 class="col-title">Stays</h2>
        <ul role="list">
          {properties.map((p) => <li><a href={`/stays/${p.slug}`}>{p.name}</a></li>)}
          <li><a href="/stays">All stays</a></li>
        </ul>
      </nav>
      <nav aria-label="Help">
        <h2 class="col-title">Help</h2>
        <ul role="list">
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/#long-stays">Long stays</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="col-title">Contact</h2>
        <ul role="list">
          <li><a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp us<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>
    <p class="legal">© {year} Marvelous Living. Designed to feel like home.</p>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(4rem, 9vw, 7rem) 2rem; overflow: hidden; }
  .cols { display: grid; gap: 2.5rem; grid-template-columns: 2fr repeat(3, 1fr); }
  .logo { height: 56px; width: auto; margin-bottom: 1.25rem; }
  .intro { color: var(--ink-on-dark-soft); max-width: 36ch; }
  .col-title {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-on-dark-soft);
    margin-bottom: 1rem;
  }
  ul { display: grid; gap: 0.35rem; }
  a { text-decoration: none; color: var(--ink-on-dark); overflow-wrap: anywhere; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .legal { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line-on-dark); color: var(--ink-on-dark-soft); font-size: var(--step--1); max-width: none; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .cols > :first-child { grid-column: 1 / -1; } }
</style>
